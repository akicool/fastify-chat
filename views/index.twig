<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Fastify Chat</title>
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
    <style>
        body { font-family: Arial, sans-serif; max-width: 600px; margin: 20px auto; text-align: center; }
        input, button { margin: 5px; padding: 10px; }
        #messages { border: 1px solid #ddd; height: 300px; overflow-y: scroll; padding: 10px; text-align: left; }
    </style>
</head>
<body>
    <h2>Fastify Chat</h2>
    <p>Онлайн пользователей: <span id="online-count">{{ onlineUsers }}</span></p>

    <div id="username-form">
        <input type="text" id="username" placeholder="Введите ник" />
        <button onclick="setUsername()">Войти</button>
    </div>

    <div id="chat" style="display: none;">
        <div id="messages"></div>
        <input type="text" id="message" placeholder="Введите сообщение" />
        <button onclick="sendMessage()">Отправить</button>
    </div>

    <script>
        const socket = io();
        let username = "";

        function setUsername() {
            username = document.getElementById("username").value.trim();
            if (username) {
                socket.emit("set_username", username);
                document.getElementById("username-form").style.display = "none";
                document.getElementById("chat").style.display = "block";
            }
        }

        function sendMessage() {
            let msg = document.getElementById("message").value.trim();
            if (msg) {
                socket.emit("chat_message", msg);
                document.getElementById("message").value = "";
            }
        }

        socket.on("chat_message", (data) => {
            let messages = document.getElementById("messages");
            messages.innerHTML += `<p><strong>${data.user}:</strong> ${data.message}</p>`;
            messages.scrollTop = messages.scrollHeight;
        });

        socket.on("update_users", (count) => {
            document.getElementById("online-count").innerText = count;
        });
    </script>
</body>
</html>